# ---------------------------------------------------------------------------
# Planora — variables de entorno
# Copia este archivo como `.env.local` y rellena tus propias credenciales.
# NUNCA subas `.env.local` al repositorio ni pongas secretos reales aquí.
# ---------------------------------------------------------------------------

# URL pública de la app (sin barra final).
# Local: http://localhost:3000 · Producción: https://tu-dominio.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Solo servidor. Nunca la expongas al navegador ni la prefijes con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Stripe -----------------------------------------------------------------
# Sin estas variables Planora funciona, pero nadie puede pasar a Pro.
# Los importes se cambian en src/config/pricing.ts, no aquí.

# Developers -> API keys -> Secret key
STRIPE_SECRET_KEY=sk_test_xxx

# Developers -> Webhooks -> tu endpoint -> Signing secret
# Sin esto el webhook rechaza TODO, que es lo correcto.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Products -> Planora Pro -> los dos precios que crees
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_YEARLY=price_xxx

# --- IA ---------------------------------------------------------------------
# Sin estas variables Planora sigue funcionando: los planes los genera su
# propio planificador. Con ellas, los genera la IA.
#
# Proveedor activo: anthropic | openai | gemini
# (hoy sólo anthropic está implementado; los otros dos son huecos preparados)
AI_PROVIDER=anthropic
AI_API_KEY=sk-ant-xxx
AI_MODEL=claude-opus-5

# Esfuerzo de razonamiento: low | medium | high
# Por defecto "medium": el alumno está esperando en el móvil. Sube a "high" si
# prefieres mejores planes aunque tarden más.
AI_EFFORT=medium

# Si los clasificadores de seguridad de Anthropic declinan una petición, el
# servidor la reintenta con otro modelo. Usa API en beta: ponlo a "false" para
# desactivarlo (Planora seguirá cayendo a su planificador local).
AI_REFUSAL_FALLBACK=true
